<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B365D"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/custom_header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/header_gradient"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/header_scrim_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_scrim" />

        <LinearLayout
            android:id="@+id/header_logo_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <!-- CPL Website Logo Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:id="@+id/logo_cpl_web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="CPL Website"
                    android:src="@drawable/ic_cpl_logo" />
            </androidx.cardview.widget.CardView>

            <!-- Events Calendar Logo Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:id="@+id/logo_events_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Events Calendar"
                    android:src="@drawable/ic_calendar_logo" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <TextView
            android:id="@+id/header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:layout_toStartOf="@id/header_logo_container"
            android:layout_centerVertical="true"
            android:text="Chetwynd Public Library"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:shadowColor="#FF000000"
            android:shadowDx="3"
            android:shadowDy="5"
            android:shadowRadius="8" />

    </RelativeLayout>

    <WebView
        android:id="@+id/webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/custom_header"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/rounded_nav_bg"
        app:backgroundTint="@null"
        app:containerColor="@android:color/transparent"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:itemActiveIndicatorStyle="@null"
        app:itemTextAppearanceActive="@style/BottomNavLabelStyle"
        app:itemTextAppearanceInactive="@style/BottomNavLabelStyle" />

    <!-- Fullscreen Loading / Splash Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B365D"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        android:elevation="100dp">

        <!-- Dynamic Splash Graphic (Loaded exclusively via Glide from theme.json) -->
        <ImageView
            android:id="@+id/loading_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Centered Library Logo -->
        <ImageView
            android:id="@+id/loading_logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cpl_logo" />

        <!-- Loading Progress Spinner -->
        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="90dp"
            android:indeterminateTint="#FFFFFF" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
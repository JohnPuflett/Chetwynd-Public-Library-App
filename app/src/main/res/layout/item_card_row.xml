<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#FFFFFF" android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/row_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/row_card_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="2dp" />

        <ImageView
            android:id="@+id/row_barcode_image"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitXY"
            android:contentDescription="Library card barcode layout" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/btn_fill_form"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:text="Fill Form"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone" /> <TextView
        android:id="@+id/btn_edit_card"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:background="#E0E0E0"
        android:textColor="#333333"
        android:text="Edit"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/btn_delete_card"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:background="#FFCDD2"
            android:textColor="#B71C1C"
            android:text="Delete"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

</LinearLayout>